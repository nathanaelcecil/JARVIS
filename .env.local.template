# JARVIS environment template
# Copy this file to .env.local and fill in only the integrations you use.
# .env.local is git-ignored; never commit real keys.

# ── Supabase (optional: history, memory, schedules, Google/Notion tokens) ──
# Project Settings → API. The service-role key is server-side only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local Ollama (default model backend) ──
# No API key is needed locally. Keep the model resident to avoid reload stalls.
OLLAMA_KEEP_ALIVE=-1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# Per-route model overrides (all default to qwen2.5:14b):
# OLLAMA_FAST_MODEL=
# OLLAMA_SMART_MODEL=
# OLLAMA_RESEARCH_MODEL=
# OLLAMA_CODING_MODEL=
# OLLAMA_AGENT_MODEL=
# OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── Local voice (XTTS-v2) ──
# XTTS_URL=http://127.0.0.1:8080
# VOICE_SAMPLE_PATH=./voice_sample.wav
# Local speech-to-text (whisper.cpp):
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=./models/ggml-small.en.bin
# STT_LANG=en

# ── Google OAuth (optional: Gmail + Calendar) ──
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Exactly 32 random bytes, base64 or hex. Generate one with:
#   openssl rand -base64 32
# Google tokens are AES-256-GCM encrypted at rest; without a valid
# key the Google integration stays disconnected (never plaintext).
# TOKEN_ENCRYPTION_KEY=
# Rotation: briefly keep the old key so rows can be re-encrypted:
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── Notion (optional) ──
# NOTION_API_KEY=

# ── Local tool agent / coding agent ──
# LOCAL_AGENT_PORT=3008
# JARVIS_AGENT_MAX_ITERATIONS=10
# JARVIS_AGENT_TIMEOUT_MS=720000

# JARVIS Hands: read-only screen helper (override the built default path)
JARVIS_HANDS_BIN=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
JARVIS_APPROVAL_KEY_FILE=
JARVIS_ALLOWED_ORIGINS=
